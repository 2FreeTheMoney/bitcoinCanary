# canaryEW environment configuration.
# Install as /etc/canaryew/canaryew.env, owned root:canaryew, mode 0640.
# Read by the systemd units (EnvironmentFile) AND by hand-run canaryew CLI
# commands, so both always see the same configuration.
#
# Secrets policy (docs/DESIGN.md S6):
#   - The SMTP *password* never goes here. It lives in the sealed store:
#     run `canaryew set-smtp-password`.
#   - The brrr webhook secret DOES go here, deliberately: it must be usable
#     before the store is unlocked so the post-reboot LOCKED notice can reach
#     you. An attacker reading this file can spam your phone; they cannot
#     forge an authenticated all-clear.

CANARYEW_HOME=/var/lib/canaryew

# --- Bitcoin Core -----------------------------------------------------------
CANARYEW_RPC_URL=http://127.0.0.1:8332
CANARYEW_RPC_COOKIE_FILE=/var/lib/bitcoind/.cookie

# --- Cadence ----------------------------------------------------------------
# Poll every 10 minutes; positive heartbeat every 6 hours.
CANARYEW_POLL_INTERVAL_SECONDS=600
CANARYEW_HEARTBEAT_INTERVAL_SECONDS=21600

# --- Alert content ----------------------------------------------------------
# minimal | standard | full  (full adds txids/amounts; PGP-encrypted mail only)
CANARYEW_REDACTION=minimal

# --- brrr.now push (secondary channel, pre-unlock channel) ------------------
# API base URL (including the version path); override for a compatible service.
CANARYEW_BRRR_API_BASE=https://api.brrr.now/v1
CANARYEW_BRRR_SECRET=

# --- Email (primary channel) ------------------------------------------------
# Password: `canaryew set-smtp-password` (sealed store, not this file).
CANARYEW_SMTP_MODE=smtp
CANARYEW_SMTP_HOST=
CANARYEW_SMTP_PORT=587
CANARYEW_SMTP_USER=
CANARYEW_SMTP_FROM=
CANARYEW_SMTP_TO=

# --- PGP --------------------------------------------------------------------
# Key id / fingerprint / email of YOUR public key. Import it with
# `canaryew pgp-import --key yourkey.asc`. Leave empty to send plaintext mail
# (not recommended: your mail server then sees alert contents).
CANARYEW_PGP_RECIPIENT=
